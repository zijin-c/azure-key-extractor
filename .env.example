# 浏览器设置（VPS 部署建议开启无头模式 true，原生省内存且无需 Xvfb；本地调试可设为 false）
HEADLESS=true
SLOW_MO=80
TIMEOUT=60000

# 代理设置（留空则直连）
# 格式: socks5://user:pass@host:port  或  http://host:port
PROXY=

# VLESS 前置代理（可选，需同时设置 PROXY）
VLESS_PROXY=

# Chromium 路径（留空则自动检测）
CHROMIUM_PATH=

# 超时设置（毫秒）
PAGE_LOAD_TIMEOUT=90000
ELEMENT_TIMEOUT=30000
PORTAL_WAIT=120
