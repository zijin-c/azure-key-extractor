# 浏览器设置（VPS 部署建议开启无头模式 true，原生省内存且无需 Xvfb；本地调试可设为 false）
HEADLESS=true
SLOW_MO=80
TIMEOUT=60000

# 代理设置（留空则直连）
# 格式: socks5://user:pass@host:port  或  http://host:port
PROXY=

# VLESS 前置代理（可选，需同时设置 PROXY）
VLESS_PROXY=

# Chromium 路径（留空则自动检测）
CHROMIUM_PATH=

# 超时设置（毫秒）
PAGE_LOAD_TIMEOUT=90000
ELEMENT_TIMEOUT=30000
PORTAL_WAIT=120
# 可选：至少 32 个字符的独立会话密钥；留空时自动持久化到 data/session_secret
AZURE_KEY_SESSION_SECRET=

# 省流量：本地响应明确的 OneCollector / Portal Telemetry 上报；false 可关闭
BLOCK_TELEMETRY=true

# 静态缓存每小时检查：清理长期不用的条目，超出目标容量时优先淘汰最久未使用的资源
HTTP_CACHE_IDLE_DAYS=30
HTTP_CACHE_MAX_MB=512
